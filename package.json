{
  "name": "gst-kit",
  "version": "0.2.9",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:native": "node-gyp rebuild",
    "build:ts": "rolldown -c rolldown.config.mjs",
    "build": "npm run clean && npm run build:native && npm run build:ts",
    "test:unit": "vitest --no-watch --no-file-parallelism --sequence.concurrent=false",
    "test:unit:bun": "bun x vitest --no-watch --no-file-parallelism --sequence.concurrent=false",
    "test:unit:deno": "deno run -A --node-modules-dir=auto npm:vitest --no-watch --no-file-parallelism --sequence.concurrent=false",
    "test": "npm run test:unit",
    "prepublishOnly": "npm run build:ts",
    "postinstall": "node scripts/ensure-native-addon.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check"
  },
  "keywords": [
    "gstreamer",
    "multimedia",
    "streaming",
    "video",
    "audio",
    "pipeline",
    "native",
    "addon",
    "typescript"
  ],
  "author": {
    "name": "Serhii Mamedov",
    "email": "bboyvivus@gmail.com"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git@github.com:repugraf/gst-kit.git"
  },
  "homepage": "https://github.com/repugraf/gst-kit",
  "description": "Node.js binding for GStreamer, providing high-level APIs for multimedia streaming and processing",
  "dependencies": {
    "node-addon-api": "8.9.0",
    "node-gyp": "13.0.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "rolldown": "1.2.1",
    "rolldown-plugin-dts": "0.28.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "vitest": {
      "vite": "8.2.0"
    },
    "tar": "7.5.22"
  }
}
